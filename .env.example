# Google Gemini API Key
# You can get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# [Optional] Google Gemini Model Name
# If the default model is not available for your API key, you can specify a different one.
# Find available models in Google AI Studio or through the API.
GEMINI_MODEL_NAME=gemini-1.5-flash-latest

# [Optional] Server Port
# You can override the default port for the server.
# PORT=3001
